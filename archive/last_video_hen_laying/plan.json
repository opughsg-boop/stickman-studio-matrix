 "captions": [
  {
   "text": "إزاي الفلاح",
   "start": 0,
   "end": 1.35
  },
  {
   "text": "بيعرف الدجاجة",
   "start": 1.1,
   "end": 2.33
  },
  {
   "text": "بتبيض من",
   "start": 2.08,
   "end": 3.17
  },
  {
   "text": "غير ما",
   "start": 2.92,
   "end": 3.47
  },
  {
   "text": "يشوفها؟",
   "start": 3.22,
   "end": 3.64
  },
  {
   "text": "بُص الدجاجة",
   "start": 3.64,
   "end": 5.59
  },
  {
   "text": "قبل ما",
   "start": 5.34,
   "end": 5.93
  },
  {
   "text": "تبيض بتبدأ",
   "start": 5.68,
   "end": 6.81
  },
  {
   "text": "تتحرّك بشكل",
   "start": 6.56,
   "end": 7.61
  },
  {
   "text": "مختلف وبتدوّر",
   "start": 7.36,
   "end": 8.91
  },
  {
   "text": "على مكان",
   "start": 8.66,
   "end": 9.39
  },
  {
   "text": "هادي",
   "start": 9.14,
   "end": 10
  },
  {
   "text": "ولما تلاقي",
   "start": 10,
   "end": 10.85
  },
  {
   "text": "العشة بتدخل",
   "start": 10.6,
   "end": 12.21
  },
  {
   "text": "وتقعد بهدوء",
   "start": 11.96,
   "end": 13.35
  },
  {
   "text": "وبتفرد ريشها",
   "start": 13.1,
   "end": 14.35
  },
  {
   "text": "وكأنها بتحضن",
   "start": 14.1,
   "end": 15.37
  },
  {
   "text": "حاجة",
   "start": 15.12,
   "end": 15.96
  },
  {
   "text": "وبتطلّع صوت",
   "start": 15.96,
   "end": 16.95
  },
  {
   "text": "مميّز صوت",
   "start": 16.7,
   "end": 18.27
  },
  {
   "text": "تعرفه أي",
   "start": 18.02,
   "end": 18.97
  },
  {
   "text": "فلاح من",
   "start": 18.72,
   "end": 19.55
  },
  {
   "text": "بعيد",
   "start": 19.3,
   "end": 19.66
  },
  {
   "text": "بعد شوية",
   "start": 19.66,
   "end": 21.35
  },
  {
   "text": "الفلاح بيدخل",
   "start": 21.1,
   "end": 22.37
  },
  {
   "text": "العشة ويحط",
   "start": 22.12,
   "end": 23.37
  },
  {
   "text": "إيده تحتها",
   "start": 23.12,
   "end": 24.07
  },
  {
   "text": "بحذر ويسحب",
   "start": 23.82,
   "end": 25.33
  },
  {
   "text": "البيضة",
   "start": 25.08,
   "end": 25.84
  },
  {
   "text": "وخلّي بالك",
   "start": 25.84,
   "end": 26.83
  },
  {
   "text": "البيضة الجديدة",
   "start": 26.58,
   "end": 27.95
  },
  {
   "text": "بتكون دافية",
   "start": 27.7,
   "end": 28.67
  },
  {
   "text": "لأن الدجاجة",
   "start": 28.42,
   "end": 29.59
  },
  {
   "text": "لسه سايباها",
   "start": 29.34,
   "end": 30.33
  },
  {
   "text": "من جسمها",
   "start": 30.08,
   "end": 30.64
  },
  {
   "text": "والبيضة بتكون",
   "start": 30.64,
   "end": 32.07
  },
  {
   "text": "لسه مبلولة",
   "start": 31.82,
   "end": 32.99
  },
  {
   "text": "بطبقة رقيقة",
   "start": 32.74,
   "end": 33.93
  },
  {
   "text": "بتجف بعد",
